{
  "model": "study-office-dropout-xgb",
  "version": "2026-10-04",
  "target": "left (1 = left later in the semester)",
  "numeric_features": [
    "age",
    "admission_grade",
    "international",
    "first_gen",
    "su_scholarship",
    "fees_owed",
    "moved_from_home",
    "married",
    "evening_programme",
    "logins_total",
    "logins_last3",
    "logins_trend",
    "submitted_share",
    "missed_last3",
    "quiz_mean",
    "weeks_since_login"
  ],
  "categorical_features": [
    "programme",
    "gender"
  ],
  "categories": {
    "programme": [
      "Business Administration",
      "Communication & Digital Media",
      "Health Science",
      "Learning & Innovation",
      "Social Work",
      "Software",
      "Sustainable Biotechnology",
      "Tourism"
    ],
    "gender": [
      "female",
      "male"
    ]
  },
  "periods": {
    "train": "2023 and 2024 cohorts",
    "validation": "2025 cohort",
    "test": "2026 cohort"
